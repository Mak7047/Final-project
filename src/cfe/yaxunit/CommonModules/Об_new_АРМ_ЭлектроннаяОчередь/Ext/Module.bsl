    ЗаписьJSON.УстановитьСтроку(тПараметрыJSON);
    ЗаписатьJSON(ЗаписьJSON, КорневойЭлемент);
    РезультатЗаписи = ЗаписьJSON.Закрыть();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	Метод = "/DemoUP_Server/hs/Ochered/GetListOfOrders";
	
	HTTP_Запрос = Новый HTTPЗапрос(Метод, Заголовки);
    HTTP_Запрос.УстановитьТелоИзСтроки(РезультатЗаписи, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = ПолучитьСписокЗаказовGET_ПолучитьСписок(HTTP_Запрос);
	СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();

	ЧтениеJSON 		 = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
	ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON,Ложь);
	ЧтениеJSON.Закрыть();
	
    КВыдаче = ДанныеОтвета.ForIssue;
	Ожидающие = ДанныеОтвета.Waiting;

	 ЮТест.ОжидаетЧто(КВыдаче.Количество())
    	.Больше(0);
	  
	 ЮТест.ОжидаетЧто(Ожидающие.Количество())
