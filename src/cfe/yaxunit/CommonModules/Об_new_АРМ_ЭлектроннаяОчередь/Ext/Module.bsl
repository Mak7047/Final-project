Процедура Тест_ДобавлениеЗаказаВОчередь() Экспорт

	// Подготовка тестовых данных
    КодОрганизация = "000000003";
	СсылкаОрганизация = ЮТест.Данные().СсылкаПоРеквизиту("Справочник.Организации", "Код", КодОрганизация);
	
	КодКонтрагент = "000000014";
	СсылкаКонтрагент = ЮТест.Данные().СсылкаПоРеквизиту("Справочник.Контрагенты", "Код", КодКонтрагент);
	
	КодСклад = "000000001";
	СсылкаСклад = ЮТест.Данные().СсылкаПоРеквизиту("Справочник.Склады", "Код", КодСклад);
	    
	КодВидЦен = "000000003";
	СсылкаВидЦен = ЮТест.Данные().СсылкаПоРеквизиту("Справочник.ВидыЦен", "Код", КодВидЦен);

	Наименование = "Bosch1234";
	СсылкаТовар = ЮТест.Данные().СсылкаПоРеквизиту("Справочник.Товары", "наименование", Наименование);
	
	Цена = 3500;
	Сумма = 3500;
	Количество = 1;
	
	ДокументЗаказ = ЮТест.Данные().КонструкторОбъекта("Документ.Заказ")
	.ФикцияОбязательныхПолей() // Автоматически заполняем обязательные поля
	.Установить("Дата", ТекущаяДатаСеанса())
	.Установить("Покупатель", СсылкаКонтрагент) 
	.Установить("Склад", СсылкаСклад) 
	.Установить("ВидЦен", СсылкаВидЦен) 
	.Установить("Организация", СсылкаОрганизация) 
	.Установить("СостояниеЗаказа", Перечисления.СостоянияЗаказов.Открыт)  
	.Установить("Автор", Справочники.Пользователи.НайтиПоНаименованию("Администратор", Истина)) 
	.Установить("Сумма", Сумма)
		.ТабличнаяЧасть("Товары")
			.ДобавитьСтроку()
				.Установить("Товар", Справочники.Товары.НайтиПоНаименованию("Bosch1234", Истина)) 
				.Установить("Цена", Цена) 
				.Установить("Количество", 1) 
				.Установить("Сумма", Сумма)
	.Провести() // Проводим документ и возвращаем ссылку
	;

	// Перевод в статус "В работе"
	ДокументОбъект = ДокументЗаказ.ПолучитьОбъект();
	ДокументОбъект.СостояниеЗаказа = Перечисления.СостоянияЗаказов.ВРаботе;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.new_ЭлектроннаяОчередь")
	.СодержитЗаписи(ЮТест.Предикат() 
	.Реквизит("Заказ").Равно(ДокументЗаказ));
	
