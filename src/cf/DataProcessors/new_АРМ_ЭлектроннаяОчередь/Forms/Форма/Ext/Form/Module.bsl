#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьСтатусСервер(СтатусОчереди, Заказ, ТекстОшибки)
	
	// 2026.06.04 [Task-1]
	
	СтрОчередь = Новый Структура;
	СтрОчередь.Вставить("РабочееМесто", Неопределено);
	СтрОчередь.Вставить("Заказ", 		Неопределено);
	СтрОчередь.Вставить("Статус", 		Неопределено);
	СтрОчередь.Вставить("НомерТалона",  Неопределено);
	
	НомерТалонаМаксимум = 0;
	Склад = ЭтаФорма.РабочееМесто.Склад;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	new_ЭлектроннаяОчередь.РабочееМесто КАК РабочееМесто,
		|	new_ЭлектроннаяОчередь.Заказ КАК Заказ,
		|	new_ЭлектроннаяОчередь.Статус КАК Статус,
		|	new_ЭлектроннаяОчередь.НомерТалона КАК НомерТалона,
		|	new_ЭлектроннаяОчередь.Склад КАК Склад
		|ИЗ
		|	РегистрСведений.new_ЭлектроннаяОчередь КАК new_ЭлектроннаяОчередь
		|ГДЕ
		|	new_ЭлектроннаяОчередь.Заказ = &Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(new_ЭлектроннаяОчередь.НомерТалона) КАК НомерТалона
		|ИЗ
		|	РегистрСведений.new_ЭлектроннаяОчередь КАК new_ЭлектроннаяОчередь
		|ГДЕ
		|	new_ЭлектроннаяОчередь.Склад = &Склад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	new_ЭлектроннаяОчередь.Заказ КАК Заказ
		|ИЗ
		|	РегистрСведений.new_ЭлектроннаяОчередь КАК new_ЭлектроннаяОчередь
		|ГДЕ
		|	new_ЭлектроннаяОчередь.Склад = &Склад
		|	И new_ЭлектроннаяОчередь.Статус = ЗНАЧЕНИЕ(Перечисление.new_СтатусыЭлектроннойОчереди.ВСборке)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	new_ЭлектроннаяОчередь.Заказ КАК Заказ
		|ИЗ
		|	РегистрСведений.new_ЭлектроннаяОчередь КАК new_ЭлектроннаяОчередь
		|ГДЕ
		|	new_ЭлектроннаяОчередь.Склад = &Склад
		|	И new_ЭлектроннаяОчередь.Статус = ЗНАЧЕНИЕ(Перечисление.new_СтатусыЭлектроннойОчереди.ГотовКВыдаче)
		|	И new_ЭлектроннаяОчередь.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	//Запрос.УстановитьПараметр("РабочееМесто", ЭтаФорма.РабочееМесто);
    Запрос.УстановитьПараметр("Склад", Склад);
	
	Пакеты = Запрос.ВыполнитьПакет(); 
	
	ВыборкаЗаказы = Пакеты[0].Выбрать();
	ВыборкаНомера = Пакеты[1].Выбрать();
	ЗаказыВСборке = Пакеты[2];
	ЗаказыКВыдаче = Пакеты[3];
	
	Пока ВыборкаНомера.Следующий() Цикл
		НомерТалонаМаксимум = ВыборкаНомера.НомерТалона; 
	КонецЦикла;
	
	Пока ВыборкаЗаказы.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтрОчередь, ВыборкаЗаказы); 
	КонецЦикла;
	
	Если СтатусОчереди = Перечисления.new_СтатусыЭлектроннойОчереди.ВСборке Тогда
		Если СтрОчередь.РабочееМесто = Неопределено Или СтрОчередь.РабочееМесто = Справочники.new_РабочиеМестаЭлектроннойОчереди.ПустаяСсылка() Тогда
			Если Не ЗаказыВСборке.Пустой() Тогда
				ТекстОшибки = "Уже существует заказ в статусе ""В сборке"". Закончите его оформление";
				Возврат;
			КонецЕсли;	
			
			Менеджер 			  = РегистрыСведений.new_ЭлектроннаяОчередь.СоздатьМенеджерЗаписи();
			Менеджер.Заказ 		  = Заказ;
			Менеджер.РабочееМесто = ЭтаФорма.РабочееМесто;
			Менеджер.НомерТалона  = НомерТалонаМаксимум + 1;
			Менеджер.Статус 	  = СтатусОчереди;
			Менеджер.Склад        = Склад;
			
			Менеджер.Записать();
		Иначе
			ТекстОшибки = "Заказ отменен или уже находится в сборке";
			Возврат;
		КонецЕсли;
	ИначеЕсли СтатусОчереди = Перечисления.new_СтатусыЭлектроннойОчереди.ГотовКВыдаче Тогда
		
		Если СтрОчередь.РабочееМесто = Неопределено Или СтрОчередь.РабочееМесто = Справочники.new_РабочиеМестаЭлектроннойОчереди.ПустаяСсылка() Тогда
			ТекстОшибки = "Заказ не в сборке. Действие недоступно";
			Возврат;
		Иначе	
			Если СтрОчередь.РабочееМесто <> ЭтаФорма.РабочееМесто Или СтрОчередь.Статус <> Перечисления.new_СтатусыЭлектроннойОчереди.ВСборке Тогда
				ТекстОшибки = "Заказ не в сборке. Действие недоступно";
				Возврат;	
			Иначе	
				Менеджер 			  = РегистрыСведений.new_ЭлектроннаяОчередь.СоздатьМенеджерЗаписи();
				Менеджер.Заказ 		  = Заказ;
				Менеджер.РабочееМесто = ЭтаФорма.РабочееМесто;
				Менеджер.НомерТалона  = СтрОчередь.НомерТалона;
				Менеджер.Статус 	  = СтатусОчереди;
				Менеджер.Склад        = Склад;
				
				Менеджер.Записать();	
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли СтатусОчереди = Перечисления.new_СтатусыЭлектроннойОчереди.Завершен Тогда	
		Если ЗаказыКВыдаче.Пустой() Тогда
			ТекстОшибки = "Заказ еще не выдан. Действие недоступно";
			Возврат;	
		КонецЕсли;	
		
		Менеджер 			  = РегистрыСведений.new_ЭлектроннаяОчередь.СоздатьМенеджерЗаписи();
		Менеджер.Заказ 		  = Заказ;
		Менеджер.РабочееМесто = ЭтаФорма.РабочееМесто;
		Менеджер.НомерТалона  = СтрОчередь.НомерТалона;
		Менеджер.Статус 	  = СтатусОчереди;
		Менеджер.Склад        = Склад;
		
		Менеджер.Записать();
	Иначе
		Менеджер 			  = РегистрыСведений.new_ЭлектроннаяОчередь.СоздатьМенеджерЗаписи();
		Менеджер.Заказ 		  = Заказ;
		Менеджер.РабочееМесто = ЭтаФорма.РабочееМесто;
		Менеджер.НомерТалона  = СтрОчередь.НомерТалона;
		Менеджер.Статус 	  = СтатусОчереди;
		Менеджер.Склад        = Склад;
		
		Менеджер.Записать();	
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьСтатусОчередиКлиент(Заказ, СтатусОчереди)
    
	// 2026.06.04 [Task-1]
	
	ТекстОшибки = "";
	УстановитьСтатусСервер(СтатусОчереди, Заказ, ТекстОшибки);
	
	Если ТекстОшибки <> "" Тогда
		ПоказатьПредупреждение(, ТекстОшибки); 	
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура УстрановитьСтатусЗаказаСервер(Заказ, СтатусЗаказа)
	
    // 2026.06.04 [Task-1]
	
	ЗаказОбъект = Заказ.ПолучитьОбъект();
	
	Если СтатусЗаказа = Перечисления.СостоянияЗаказов.ПустаяСсылка() Тогда
		ЗаказОбъект.УстановитьПометкуУдаления(Истина);
	Иначе
		ЗаказОбъект.СостояниеЗаказа = СтатусЗаказа;
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРабочееМесто(ЭтоОператор, ЭтоСборщик)
	
	// 2026.06.04 [Task-1]
	
	ТекПользователь = Пользователи.ТекущийПользователь();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочиеМестаЭлектроннойОчереди.Ссылка КАК РабочееМесто
		|ИЗ
		|	Справочник.new_РабочиеМестаЭлектроннойОчереди КАК РабочиеМестаЭлектроннойОчереди
		|ГДЕ
		|	РабочиеМестаЭлектроннойОчереди.ПометкаУдаления = ЛОЖЬ
		|	И РабочиеМестаЭлектроннойОчереди.Операторы.Пользователь = &Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РабочиеМестаЭлектроннойОчереди.Ссылка КАК РабочееМесто
		|ИЗ
		|	Справочник.new_РабочиеМестаЭлектроннойОчереди КАК РабочиеМестаЭлектроннойОчереди
		|ГДЕ
		|	РабочиеМестаЭлектроннойОчереди.ПометкаУдаления = ЛОЖЬ
		|	И РабочиеМестаЭлектроннойОчереди.Сборщики.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", ТекПользователь);
	
	Пакеты = Запрос.ВыполнитьПакет();
	
	ВыборкаОператоры = Пакеты[0].Выбрать();
	
	Пока ВыборкаОператоры.Следующий() Цикл
		ЭтаФорма.РабочееМесто = ВыборкаОператоры.РабочееМесто;
		ЭтоОператор = Истина;
	КонецЦикла; 
	
	ВыборкаСборщики = Пакеты[1].Выбрать();
	
	Пока ВыборкаСборщики.Следующий() Цикл
		ЭтаФорма.РабочееМесто = ВыборкаСборщики.РабочееМесто;
		ЭтоСборщик = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборыЭлектроннойОчереди(ЭтоОператор, ЭтоСборщик)
	
	// 2026.06.04 [Task-1]
	
	СписокОтбора = Новый Массив;
	СписокОтбора.Добавить(ЭтаФорма.РабочееМесто);
	СписокОтбора.Добавить(Справочники.new_РабочиеМестаЭлектроннойОчереди.ПустаяСсылка());
	
	Склад = ЭтаФорма.РабочееМесто.Склад; 
	
	ЭлементОтбора 				   = Очередь.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("РабочееМесто");
	ЭлементОтбора.ВидСравнения 	   = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.Использование    = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	ЭлементОтбора.ПравоеЗначение   = СписокОтбора;

	ЭлементОтбора 				   = Очередь.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Склад");
	ЭлементОтбора.ВидСравнения 	   = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование    = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	ЭлементОтбора.ПравоеЗначение   = Склад;
	
	Если ЭтоОператор Тогда
		СписокОтбора = Новый Массив;
		СписокОтбора.Добавить(Перечисления.new_СтатусыЭлектроннойОчереди.ВСборке);
		СписокОтбора.Добавить(Перечисления.new_СтатусыЭлектроннойОчереди.ГотовКВыдаче);
		СписокОтбора.Добавить(Перечисления.new_СтатусыЭлектроннойОчереди.ПустаяСсылка());
		
		ЭлементОтбора 				   = Очередь.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Статус");
		ЭлементОтбора.ВидСравнения 	   = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = СписокОтбора;
	ИначеЕсли ЭтоСборщик Тогда 
		ЭлементОтбора 				   = Очередь.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Статус");
		ЭлементОтбора.ВидСравнения 	   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Перечисления.new_СтатусыЭлектроннойОчереди.ВСборке;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти





