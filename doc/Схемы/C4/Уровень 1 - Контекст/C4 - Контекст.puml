@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Электронная очередь - Уровень 1 - Контекст

' Внешняя система
System_Ext(MobileApp, "Мобильное приложение 1С", "Запрашивает и отображает данные электронной очереди")

' Наша система (как черный ящик)
System(OneC_UP, "1С УП", "Демонстрационное приложение. Хранит данные электронной очереди, предоставляет HTTP-сервис, включает АРМ для управления очередью")

' Связи
Rel(MobileApp, OneC_UP, "Запрашивает данные электронной очереди", "HTTP")
Rel(OneC_UP, MobileApp, "Отдает данные электронной очереди", "HTTP")

@enduml